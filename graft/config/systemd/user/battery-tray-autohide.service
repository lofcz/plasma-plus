[Unit]
Description=Hide Plasma battery tray icon when fully charged
After=plasma-plasmashell.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 __HOME__/.local/bin/battery-tray-autohide.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
